{
  "name": "mroczect/galonku-backend",
  "description": "Backend API Galonku - Aplikasi Pengelolaan Depot Air",
  "type": "project",
  "license": "GPL-3.0-only",
  "authors": [
    {
      "name": "mroczect",
      "email": "mroczect@proton.me"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "vlucas/phpdotenv": "^5.7",
    "firebase/php-jwt": "^7.1",
    "monolog/monolog": "^3.12"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "fakerphp/faker": "^1.24"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public",
    "lint": "find app -name '*.php' -exec php -l {} \\;",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite=Unit",
    "test:feat": "phpunit --testsuite=Feature",
    "test:int": "phpunit --testsuite=Integration",
    "test:cov": "phpunit --coverage-html storage/coverage",
    "db": "php ../database/db.php",
    "db:migrate": "php ../database/db.php migrate",
    "db:fresh": "php ../database/db.php fresh --seed",
    "db:reset": "php ../database/db.php reset --seed",
    "db:seed": "php ../database/db.php seed",
    "db:status": "php ../database/db.php status",
    "db:rollback": "php ../database/db.php rollback",
    "db:drop": "php ../database/db.php drop --force",
    "db:test:fresh": "APP_ENV=testing php ../database/db.php fresh --seed"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
