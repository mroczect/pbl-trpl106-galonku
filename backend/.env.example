APP_NAME="Galonku API"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=galonku_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

JWT_SECRET=change-this-to-a-random-string-of-at-least-64-characters-that-is-long-and-random
JWT_ACCESS_EXPIRE=3600
JWT_REFRESH_EXPIRE=2592000

CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000