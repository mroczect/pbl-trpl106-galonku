APP_NAME=Galonku
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=galonku
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

JWT_SECRET=change-this-to-a-random-32-char-secret
JWT_ISSUER=galonku-backend
JWT_TTL=3600

LOG_PATH=storage/logs/app.log
LOG_LEVEL=debug
